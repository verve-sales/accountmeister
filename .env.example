# Verve Sales – Beispielkonfiguration. Enthält KEINE echten Geheimnisse.
# Kopieren nach .env und Werte lokal setzen.

# PostgreSQL-Verbindung (lokale Entwicklung)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/verve_sales_dev"
# Getrennte Testdatenbank für automatisierte Tests
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/verve_sales_test"

# Anmeldemodus: "development" = klar gekennzeichnete Entwicklungsanmeldung (Nutzerwahl ohne Passwort),
# "oidc" = Unternehmensanmeldung (noch nicht konfiguriert; Entscheidung offen).
AUTH_MODE="development"

# Geheimnis für die Sitzungsverschlüsselung (mind. 32 Zeichen). Für Entwicklung beliebig, für Produktion generieren.
SESSION_SECRET="entwicklung-nur-lokal-bitte-ersetzen-0123456789abcdef"

# KI-Anbieter: "disabled" (Standard), "test" (deterministischer Testanbieter, nur Entwicklung),
# "production" (Adapter vorhanden, aber nicht freigegeben – wirft bis zur Anbieter-/Datenschutzentscheidung).
AI_PROVIDER="disabled"
# Langdock (nur bei AI_PROVIDER=langdock): Schlüssel lokal setzen, nie einchecken
# LANGDOCK_API_KEY=""
# LANGDOCK_BASE_URL="https://api.langdock.com/openai/eu/v1"
# LANGDOCK_DEFAULT_MODEL="gpt-4o-mini"
# Dokumentenupload
UPLOAD_DIR="./data/uploads"
MAX_UPLOAD_MB="25"
# Nutzungsgrenze: KI-Aufträge je Arbeitsraum und Tag
AI_DAILY_JOB_LIMIT="200"

# NODE_ENV=production zusammen mit AUTH_MODE=development oder AI_PROVIDER=test verhindert den Start (Schutz gegen unsichere Konfiguration).

# Benachrichtigungen per E-Mail (Etappe 27). Standard: aus – Glocke und Postfach im Tool funktionieren immer.
# graph: Versand über Microsoft Graph mit der vorhandenen Entra-App (Anwendungsberechtigung Mail.Send, Admin-Zustimmung)
# file: schreibt .eml-Dateien nach MAIL_FILE_DIR (Entwicklung)
# MAIL_TRANSPORT="off"
# MAIL_SENDER="accountmeister@verveconsulting.de"
# APP_BASE_URL="https://accountmeister.verveconsulting.ai"
# MAIL_DIGEST_HOUR="7"

# Besetzung (Etappe 28, E1): Lieferbereich ein-/ausschalten (kein Ersatz für serverseitige Rechte)
# FEATURE_BESETZUNG="true"
