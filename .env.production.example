# Beispiel für den Pilotbetrieb. Kopieren nach .env.production und ECHTE Werte setzen. Niemals ins Git.
# Das Installationsskript (scripts/install-server.sh) fragt diese Werte ab und erzeugt die Geheimnisse.

# Öffentliche Adresse der Anwendung (ohne https://). Die DNS-A-Adresse muss auf den Server zeigen.
DOMAIN=accountmeister.verveconsulting.ai

# Datenbank und Sitzung: lange Zufallswerte (werden vom Skript erzeugt: openssl rand -hex 32)
POSTGRES_PASSWORD=bitte-langes-zufaelliges-passwort
SESSION_SECRET=bitte-mindestens-32-zufaellige-zeichen-erzeugen

# Unternehmensanmeldung über Microsoft Entra ID (App-Registrierung, siehe docs/installation-ionos.md Schritt 4)
AUTH_MODE=oidc
OIDC_ISSUER=https://login.microsoftonline.com/<Mandanten-ID>/v2.0
OIDC_CLIENT_ID=<Anwendungs-ID (Client-ID)>
OIDC_CLIENT_SECRET=<Geheimer Clientschlüssel – Wert>
# Diese Adressen bekommen beim ersten Anmelden die Verwaltungsrolle (ADMIN). Kommagetrennt.
ADMIN_EMAILS=ivo.seifert@verveconsulting.de
# Unbekannte Personen aus dem Tenant automatisch als Zugang ohne Rolle anlegen? (false = Zugang vorher unter „Verwaltung“ anlegen)
OIDC_AUTO_CREATE_USERS=false
WORKSPACE_NAME=Verve Consulting

# KI: "disabled" bis Anbieter/Datenschutz entschieden; "test" wird in Produktion verweigert.
AI_PROVIDER=disabled
AI_DAILY_JOB_LIMIT=200
SESSION_MAX_AGE_SECONDS=43200
SESSION_IDLE_SECONDS=7200
RATE_LIMIT_LOGIN_PER_15MIN=20
RATE_LIMIT_WRITES_PER_MIN=120
