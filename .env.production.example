# Beispiel für den Pilotbetrieb mit docker-compose. Kopieren nach .env.production und ECHTE Werte setzen. Niemals ins Git.
POSTGRES_PASSWORD=bitte-langes-zufaelliges-passwort
SESSION_SECRET=bitte-mindestens-32-zufaellige-zeichen-erzeugen
# Unternehmensanmeldung: erst nach OIDC-Entscheidung konfigurierbar; "development" wird in Produktion verweigert.
AUTH_MODE=oidc
# KI: "disabled" bis Anbieter/Datenschutz entschieden; "test" wird in Produktion verweigert.
AI_PROVIDER=disabled
AI_DAILY_JOB_LIMIT=200
SESSION_MAX_AGE_SECONDS=43200
SESSION_IDLE_SECONDS=7200
RATE_LIMIT_LOGIN_PER_15MIN=20
RATE_LIMIT_WRITES_PER_MIN=120
