# Reverse-Proxy mit automatischem TLS (Let's Encrypt). {$DOMAIN} kommt aus .env.production.
{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	reverse_proxy app:3000
	log {
		output file /data/access.log {
			roll_size 20mb
			roll_keep 5
		}
		format filter {
			wrap console
			fields {
				request>uri query {
					replace * REDACTED
				}
			}
		}
	}
}
